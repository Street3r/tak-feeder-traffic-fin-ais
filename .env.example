# ---------------------------------------------------------------- TAK server
COT_URL=ssl://takserver:8089
# Old names REMOTE_SERVER_URL, REMOTE_SSL_USER_CERTIFICATE and
# REMOTE_SSL_USER_KEY still work
PYTAK_TLS_CLIENT_CERT=/data/cert.pem
PYTAK_TLS_CLIENT_KEY=/data/key.pem
PYTAK_TLS_DONT_VERIFY=1

# ---------------------------------------------------------------- Digitraffic
#MQTT_URL=wss://meri.digitraffic.fi:443/mqtt
# Part of the MQTT client id, so Fintraffic can tell the application apart
#DIGITRAFFIC_USER=tak-feeder-traffic-fin-ais

# ---------------------------------------------------------------- Vessels
# Only these AIS ship types (empty = all), e.g. 35,51,55
#AIS_TYPES=
# Affiliation by flag (MMSI MID) comes from countries.json.
# 1 = also mark Panama, Liberia, Comoros and Cook Islands suspect
#AIS_FOC_SUSPECT=0
# Own changes, MID:affiliation (f, n, u, s, h)
#AIS_AFFIL_OVERRIDES=538:s,626:s
# Shadow fleet list (tak-shadowfleet-id, CC BY-NC 4.0), downloaded daily
#SHADOWFLEET=0
#SHADOWFLEET_URL=https://raw.githubusercontent.com/sgofferj/tak-shadowfleet-id/main/shadowfleet.json
# Vessel names and the shadow fleet list are kept here (mount a volume)
#DATA_DIR=/var/lib/tak-feeder
#TIMEZONE=Europe/Helsinki

# ---------------------------------------------------------------- Output
# Seconds between send rounds (old name UPDATE_RATE)
#UPDATE_INTERVAL=5
#REFRESH_INTERVAL=30
#STALE_SECONDS=90
# Stop sending a vessel that has been silent this long (s)
#MAX_AGE=600
#SOURCE_LINE=Source: Fintraffic / digitraffic.fi, CC BY 4.0
# Unhealthy when no AIS data has arrived for this long (s)
#HEALTH_MAX_SILENCE=300
#DEBUG=0
